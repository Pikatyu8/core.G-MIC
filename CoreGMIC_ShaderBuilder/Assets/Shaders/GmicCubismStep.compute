#pragma kernel CSInitHistory
#pragma kernel CSStepQuads

RWStructuredBuffer<float4> _CurrentOffsets; // xy = current centerPx, zw = current unit direction
RWStructuredBuffer<int2> _HistoryBuffer;    // 64 slots per quad (ring buffer of previous pixel positions)

int _TotalQuads;
int _QuadsPerIter;
float _HalfSizePx;
float4 _ScreenRes; // x = width, y = height
int _DriftRadius;
int _HistoryCount;
float _Persistence;
uint _StepIndex;

#define GMIC_COMPUTE 1
#define GMIC_USE_HASH 1
#include "GmicCommon.cginc"

uint GetEffectiveHistoryLimit(int radius)
{
    uint diskCap = 0u;
    if (radius <= 0)      diskCap = 0u;
    else if (radius == 1) diskCap = 4u;  // 5 points in disk - 1
    else if (radius == 2) diskCap = 12u; // 13 points in disk - 1
    else if (radius == 3) diskCap = 28u; // 29 points in disk - 1
    else if (radius == 4) diskCap = 48u; // 49 points in disk - 1
    else                  diskCap = 63u;

    uint requested = (uint)max(0, min(_HistoryCount, 63));
    uint avail = min(requested, _StepIndex);
    return min(avail, diskCap);
}

int2 ClampReflectToBounds(int2 p, int2 minPad, int2 maxPad, inout float2 dir)
{
    if (p.x < minPad.x)
    {
        p.x = minPad.x + (minPad.x - p.x);
        dir.x = abs(dir.x);
    }
    else if (p.x > maxPad.x)
    {
        p.x = maxPad.x - (p.x - maxPad.x);
        dir.x = -abs(dir.x);
    }

    if (p.y < minPad.y)
    {
        p.y = minPad.y + (minPad.y - p.y);
        dir.y = abs(dir.y);
    }
    else if (p.y > maxPad.y)
    {
        p.y = maxPad.y - (p.y - maxPad.y);
        dir.y = -abs(dir.y);
    }

    return clamp(p, minPad, maxPad);
}

bool IsInHistory(uint histBase, uint validLen, int2 cand)
{
    for (uint h = 0u; h < validLen; h++)
    {
        uint slot = (_StepIndex - 1u - h) & 63u;
        int2 prev = _HistoryBuffer[histBase + slot];
        if (prev.x == cand.x && prev.y == cand.y)
        {
            return true;
        }
    }
    return false;
}

[numthreads(64, 1, 1)]
void CSInitHistory(uint3 dtid : SV_DispatchThreadID)
{
    uint idx = dtid.x;
    if (idx >= (uint)_TotalQuads)
    {
        return;
    }

    uint qpi = (uint)max(1, _QuadsPerIter);
    uint iterSeed = (idx / qpi) + 1u;
    uint iid = idx % qpi;

    uint seed = HashU32(iid ^ (iterSeed * 2654435761u));
    float u1 = (float)(HashU32(seed + 1u) & 0xFFFFu) / 65535.0;
    float u2 = (float)(HashU32(seed + 2u) & 0xFFFFu) / 65535.0;
    float u3 = (float)(HashU32(seed + 3u) & 0xFFFFu) / 65535.0;

    float2 res = _ScreenRes.xy;
    float2 pad = min(float2(_HalfSizePx, _HalfSizePx), res * 0.45);
    float2 baseCenterPx = lerp(pad, res - pad, float2(u1, u2));

    float initAngle = u3 * 6.28318530718;
    float s0, c0;
    sincos(initAngle, s0, c0);

    int2 initPx = int2((int)round(baseCenterPx.x), (int)round(baseCenterPx.y));
    _CurrentOffsets[idx] = float4((float)initPx.x, (float)initPx.y, c0, s0);
    _HistoryBuffer[idx * 64u] = initPx;
}

[numthreads(64, 1, 1)]
void CSStepQuads(uint3 dtid : SV_DispatchThreadID)
{
    uint idx = dtid.x;
    if (idx >= (uint)_TotalQuads)
    {
        return;
    }

    uint histBase = idx * 64u;
    float4 curState = _CurrentOffsets[idx];
    int2 curPx = _HistoryBuffer[histBase + ((_StepIndex - 1u) & 63u)];

    float2 curDir = curState.zw;
    float dirLen = length(curDir);
    curDir = (dirLen > 1e-4) ? (curDir / dirLen) : float2(1.0, 0.0);
    float baseAngle = atan2(curDir.y, curDir.x);

    float2 res = _ScreenRes.xy;
    float2 pad = min(float2(_HalfSizePx, _HalfSizePx), res * 0.45);
    int2 minPad = int2((int)ceil(pad.x), (int)ceil(pad.y));
    int2 maxPad = max(minPad, int2((int)floor(res.x - pad.x), (int)floor(res.y - pad.y)));

    int radius = max(1, _DriftRadius);
    int rSq = radius * radius;
    uint validLen = GetEffectiveHistoryLimit(radius);

    float persistence = saturate(_Persistence);
    float baseSpread = lerp(3.14159265, 0.18, persistence);

    int2 chosen = curPx;
    float2 chosenDir = curDir;
    bool found = false;

    // Correlated random walk within radius N pixels, preserving heading momentum + history.
    for (uint attempt = 0u; attempt < 24u; attempt++)
    {
        uint seed = HashU32(idx ^ (_StepIndex * 2654435761u) ^ (attempt * 1013904223u));
        float u1 = (float)(HashU32(seed + 1u) & 0xFFFFu) / 65535.0;
        float u2 = (float)(HashU32(seed + 2u) & 0xFFFFu) / 65535.0;

        float attemptSpread = min(3.14159265, baseSpread + (float)attempt * 0.14);
        float theta = baseAngle + (u2 * 2.0 - 1.0) * attemptSpread;
        float sT, cT;
        sincos(theta, sT, cT);

        float rFrac = lerp(sqrt(u1), lerp(0.55, 1.0, u1), saturate(persistence * 2.0));
        float r = (float)radius * rFrac;

        int2 step = int2((int)round(r * cT), (int)round(r * sT));
        if (step.x * step.x + step.y * step.y > rSq)
        {
            continue;
        }

        float2 candDir = float2(cT, sT);
        int2 cand = ClampReflectToBounds(curPx + step, minPad, maxPad, candDir);
        if (!IsInHistory(histBase, validLen, cand))
        {
            chosen = cand;
            chosenDir = candDir;
            found = true;
            break;
        }

        chosen = cand;
        chosenDir = candDir;
    }

    // Deterministic scan fallback for tiny step radii (e.g. N <= 4).
    if (!found && radius <= 4)
    {
        int span = radius * 2 + 1;
        int totalCells = span * span;
        int startCell = (int)(HashU32(idx ^ (_StepIndex * 747796405u)) % (uint)totalCells);

        for (int c = 0; c < totalCells; c++)
        {
            int cIdx = (startCell + c) % totalCells;
            int2 step = int2((cIdx % span) - radius, (cIdx / span) - radius);
            if (step.x * step.x + step.y * step.y > rSq)
            {
                continue;
            }

            float sLen = length(float2((float)step.x, (float)step.y));
            float2 candDir = (sLen > 1e-4) ? (float2((float)step.x, (float)step.y) / sLen) : curDir;
            int2 cand = ClampReflectToBounds(curPx + step, minPad, maxPad, candDir);
            if (!IsInHistory(histBase, validLen, cand))
            {
                chosen = cand;
                chosenDir = candDir;
                found = true;
                break;
            }
        }
    }

    _HistoryBuffer[histBase + (_StepIndex & 63u)] = chosen;
    _CurrentOffsets[idx] = float4((float)chosen.x, (float)chosen.y, chosenDir.x, chosenDir.y);
}